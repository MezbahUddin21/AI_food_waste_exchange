# Copy to .env at the repo root before running: docker compose up --build
# Values come from your Supabase project dashboard (Settings -> API).

# --- Backend (runtime, secret — never expose service role key to browsers) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=

# --- Frontend (BUILD-TIME — baked into the JS bundle, must be non-secret) ---
# NOTE: changing these requires rebuilding the frontend image
# (docker compose up --build), not just a restart.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Browser-side URL of the backend as published on the host:
VITE_API_URL=http://localhost:3000/api/v1

# If you change the frontend's published port (8080), also update
# FRONTEND_ORIGIN in docker-compose.yml to match (exact origin, no trailing slash).
